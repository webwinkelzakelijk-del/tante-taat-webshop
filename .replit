run = "sh scripts/start.sh"
entrypoint = "src/app/page.tsx"
modules = ["nodejs-20", "web"]

[nix]
channel = "stable-25_05"

[deployment]
build = ["sh", "-c", "npm ci --no-audit --no-fund && npm run build"]
run = ["sh", "-c", "npm run start"]
deploymentTarget = "cloudrun"

[[ports]]
localPort = 3000
externalPort = 80

[workflows]
runButton = "Webshop"

[[workflows.workflow]]
name = "Webshop"
mode = "sequential"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "sh scripts/start.sh"
waitForPort = 3000

[[workflows.workflow]]
name = "Pull latest & restart"
mode = "sequential"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "git fetch origin && git reset --hard origin/main && sh scripts/start.sh"
waitForPort = 3000
